# Copy to .env.local for local development, or enter these values in your hosting dashboard.
# These PUBLIC_ values are visible to browsers; never put passwords or tokens here.
PUBLIC_SITE_LANG=zh_CN
PUBLIC_DISPLAY_SETTINGS=false

# Optional first-release page switches (uncomment to use).
# PUBLIC_PAGES_FRIENDS=false
# PUBLIC_PAGES_GUESTBOOK=false
# PUBLIC_PAGES_DYNAMIC=false
# PUBLIC_PAGES_PROJECTS=false
# PUBLIC_PAGES_GALLERY=false
# PUBLIC_PAGES_BOOKNAV=false
# PUBLIC_PAGES_SPONSOR=false

# Pure static hosting: leave CF_WORKERS unset.
# Site title, profile and domain belong in src/config/*.ts, not invented env variables.
# No secret is required for the basic static blog.
